<div class="page-header">
  <div>
    <h1 class="page-title">Reservas</h1>
    <p class="page-subtitle">
      Administración, consulta y filtrado de reservas del sistema.
    </p>
  </div>
</div>

<div class="filter-card">
  <%= form_with url: admin_reservations_path, method: :get, local: true, class: "filter-form" do |f| %>
    <!-- Filtro por Complejo Deportivo -->
    <div class="filter-group">
      <%= f.label :sports_complex_id, "Complejo Deportivo", class: "visually-hidden" %>
      <%= f.select :sports_complex_id,
                   options_from_collection_for_select(@sports_complexes, :id, :name, params[:sports_complex_id]),
                   { include_blank: "Todos los complejos" },
                   class: "form-input",
                   "aria-label": "Filtrar por complejo deportivo" %>
    </div>

    <!-- Filtro por Estado -->
    <div class="filter-group">
      <%= f.label :status, "Estado", class: "visually-hidden" %>
      <%= f.select :status,
                   options_for_select([
                     ["Confirmada", "confirmed"],
                     ["Pendiente", "pending"],
                     ["Cancelada", "cancelled"]
                   ], params[:status]),
                   { include_blank: "Todos los estados" },
                   class: "form-input",
                   "aria-label": "Filtrar por estado" %>
    </div>

    <!-- Selector de Ordenamiento -->
    <div class="filter-group">
      <%= f.label :order_by_date, "Ordenar por Fecha", class: "visually-hidden" %>
      <%= f.select :order_by_date,
                   options_for_select([
                     ["Fecha: Más recientes", "desc"],
                     ["Fecha: Más antiguas", "asc"]
                   ], params[:order_by_date] || "desc"),
                   {},
                   class: "form-input",
                   "aria-label": "Ordenar por fecha" %>
    </div>

    <!-- Botones de Acción -->
    <div class="filter-actions">
      <%= f.submit "Filtrar", class: "btn btn-primary" %>
      <% if params[:sports_complex_id].present? || params[:status].present? || (params[:order_by_date].present? && params[:order_by_date] != "desc") %>
        <%= link_to "Limpiar", admin_reservations_path, class: "btn btn-secondary", title: "Limpiar filtros aplicados" %>
      <% end %>
    </div>
  <% end %>
</div>

<table class="admin-table">
  <thead>
    <tr>
      <th>ID</th>
      <th>Fecha</th>
      <th>Horario</th>
      <th>Cliente</th>
      <th>Complejo</th>
      <th>Cancha</th>
      <th>Total</th>
      <th>Estado</th>
    </tr>
  </thead>
  <tbody>
    <% if @reservations.any? %>
      <% @reservations.each do |reservation| %>
        <tr>
          <td>#<%= reservation.id %></td>
          <td><%= reservation.reservation_date.strftime("%d/%m/%Y") %></td>
          <td>
            <%= reservation.start_time.strftime("%H:%M") %> - <%= reservation.end_time.strftime("%H:%M") %> hs
          </td>
          <td>
            <strong><%= reservation.user.name %></strong>
            <span class="table-subtext"><%= reservation.user.email %></span>
          </td>
          <td><%= reservation.court.sports_complex.name %></td>
          <td><%= reservation.court.name %> (<%= reservation.court.sport.name %>)</td>
          <td>$<%= number_with_precision(reservation.total_price, precision: 2, delimiter: ".") %></td>
          <td>
            <% case reservation.status %>
            <% when "confirmed", 1 %>
              <span class="badge badge-success">Confirmada</span>
            <% when "pending", 0 %>
              <span class="badge badge-warning">Pendiente</span>
            <% when "cancelled", 2 %>
              <span class="badge badge-danger">Cancelada</span>
            <% else %>
              <span class="badge badge-secondary"><%= reservation.status %></span>
            <% end %>
          </td>
        </tr>
      <% end %>
    <% else %>
      <tr>
        <td colspan="8" class="table-empty">
          No se encontraron reservas con los filtros aplicados.
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<% if defined?(@pagy) && @pagy && @pagy.pages > 1 %>
  <div class="pagination-container">
    <div class="pagination-info">
      Mostrando <strong><%= @pagy.from %></strong> - <strong><%= @pagy.to %></strong> de <strong><%= @pagy.count %></strong> reservas
    </div>
    <div class="pagination-links">
      <%== pagy_nav(@pagy) %>
    </div>
  </div>
<% end %>
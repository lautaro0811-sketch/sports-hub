<%= form_with model: [:admin, court], class: "admin-card" do |f| %>
  <% if court.errors.any? %>
    <div class="form-errors">
      <h3>Se encontraron <%= court.errors.count %> error(es) que impiden guardar la cancha:</h3>
      <ul>
        <% court.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= f.label :name, "Nombre o identificador", class: "form-label" %>
    <%= f.text_field :name, required: true, autofocus: true, class: "form-input", placeholder: "Ej. Cancha 1 (Techada)" %>
  </div>

  <div class="form-group">
    <%= f.label :sports_complex_id, "Complejo Deportivo", class: "form-label" %>
    <%= f.collection_select :sports_complex_id, SportsComplex.order(:name), :id, :name, { prompt: "Seleccione un complejo" }, { class: "form-input", required: true } %>
  </div>

  <div class="form-group">
    <%= f.label :sport_id, "Deporte", class: "form-label" %>
    <%= f.collection_select :sport_id, Sport.order(:name), :id, :name, { prompt: "Seleccione un deporte" }, { class: "form-input", required: true } %>
  </div>

  <div class="form-group">
    <%= f.label :surface_type, "Tipo de superficie", class: "form-label" %>
    <%= f.text_field :surface_type, required: true, class: "form-input", placeholder: "Ej. Sintético, Polvo de ladrillo, Cemento, Parquet" %>
  </div>

  <div class="form-group">
    <label class="form-label">
      <%= f.check_box :is_active %>
      Cancha disponible para reservas
    </label>
  </div>

  <div class="form-actions">
    <%= f.submit court.new_record? ? "Crear Cancha" : "Actualizar Cancha", class: "btn btn-primary" %>
    <%= link_to "Cancelar", admin_courts_path, class: "btn btn-secondary" %>
  </div>
<% end %>
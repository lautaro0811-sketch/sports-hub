<div class="page-header">
  <div>
    <h1 class="page-title">Canchas</h1>
    <p class="page-subtitle">
      Administración de canchas, precios base, esquemas tarifarios asociados y disponibilidad.
    </p>
  </div>
  <%= link_to "Nueva Cancha", new_admin_court_path, class: "btn btn-primary" %>
</div>

<div class="filter-card">
  <%= form_with url: admin_courts_path, method: :get, local: true, class: "filter-form" do |f| %>
    <!-- Búsqueda por Nombre -->
    <div class="filter-group filter-group-main">
      <%= f.label :name, "Buscar por nombre", class: "visually-hidden" %>
      <%= f.text_field :name,
                       value: params[:name],
                       placeholder: "Buscar por nombre de cancha...",
                       class: "form-input",
                       "aria-label": "Buscar por nombre de cancha" %>
    </div>

    <!-- Filtro por Complejo Deportivo -->
    <div class="filter-group">
      <%= f.label :sports_complex_id, "Complejo Deportivo", class: "visually-hidden" %>
      <%= f.select :sports_complex_id,
                   options_from_collection_for_select(@sports_complexes, :id, :name, params[:sports_complex_id]),
                   { include_blank: "Todos los complejos" },
                   class: "form-input",
                   "aria-label": "Filtrar por complejo deportivo" %>
    </div>

    <!-- Filtro por Deporte -->
    <div class="filter-group">
      <%= f.label :sport_id, "Deporte", class: "visually-hidden" %>
      <%= f.select :sport_id,
                   options_from_collection_for_select(@sports, :id, :name, params[:sport_id]),
                   { include_blank: "Todos los deportes" },
                   class: "form-input",
                   "aria-label": "Filtrar por deporte" %>
    </div>

    <!-- Acciones de Búsqueda -->
    <div class="filter-actions">
      <%= f.submit "Buscar", class: "btn btn-primary" %>
      <% if params[:name].present? || params[:sports_complex_id].present? || params[:sport_id].present? %>
        <%= link_to "Limpiar", admin_courts_path, class: "btn btn-secondary", title: "Restablecer filtros" %>
      <% end %>
    </div>
  <% end %>
</div>

<table class="admin-table">
  <thead>
    <tr>
      <th>Nombre</th>
      <th>Complejo</th>
      <th>Deporte</th>
      <th>Precio Base</th>
      <th>Esquema Tarifario</th>
      <th>Estado</th>
      <th class="text-right">Acciones</th>
    </tr>
  </thead>
  <tbody>
    <% if @courts.any? %>
      <% @courts.each do |court| %>
        <tr>
          <td><strong><%= court.name %></strong></td>
          <td><%= court.sports_complex.name %></td>
          <td><%= court.sport.name %></td>
          <td>
            <strong class="price-highlight">$<%= number_with_precision(court.base_price, precision: 2) %></strong>
          </td>
          <td>
            <% if court.pricing_scheme_id.present? %>
              <span class="badge badge-success"><%= court.pricing_scheme.name %></span>
              <span class="table-subtext">Personalizado</span>
            <% elsif court.sports_complex&.default_pricing_scheme.present? %>
              <span class="badge badge-secondary"><%= court.sports_complex.default_pricing_scheme.name %></span>
              <span class="table-subtext">Heredado del complejo</span>
            <% else %>
              <span class="table-subtext">Sin esquema (Multiplicador 1.0)</span>
            <% end %>
          </td>
          <td>
            <% if court.is_active? %>
              <span class="badge badge-success">Activa</span>
            <% else %>
              <span class="badge badge-secondary">Inactiva</span>
            <% end %>
          </td>
          <td>
            <div class="table-actions text-right">
              <%= link_to "Turnos", admin_court_time_slots_path(court), class: "btn btn-sm btn-primary", title: "Configurar franjas de disponibilidad" %>
              <%= link_to "Editar", edit_admin_court_path(court), class: "btn btn-sm btn-secondary" %>
              <%= button_to "Eliminar", admin_court_path(court), method: :delete, data: { turbo_confirm: "¿Seguro que querés eliminar la cancha #{court.name}?" }, class: "btn btn-sm btn-danger" %>
            </div>
          </td>
        </tr>
      <% end %>
    <% else %>
      <tr>
        <td colspan="7" class="table-empty">
          <% if params[:name].present? || params[:sports_complex_id].present? || params[:sport_id].present? %>
            No se encontraron canchas que coincidan con los criterios de búsqueda.
          <% else %>
            No hay canchas registradas todavía.
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<% if defined?(@pagy) && @pagy && @pagy.pages > 1 %>
  <div class="pagination-container">
    <div class="pagination-info">
      Mostrando <strong><%= @pagy.from %></strong> - <strong><%= @pagy.to %></strong> de <strong><%= @pagy.count %></strong> canchas
    </div>
    <div class="pagination-links">
      <%== pagy_nav(@pagy) %>
    </div>
  </div>
<% end %>
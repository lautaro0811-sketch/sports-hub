<div class="page-header mb-md">
  <div>
    <div class="header-badges">
      <span class="badge badge-secondary"><%= @court.sports_complex.name %> &bull; <%= @court.sport.name %></span>
      <span class="badge badge-secondary badge-price">Precio base: $<%= number_with_precision(@court.base_price, precision: 2) %></span>
      <% if @court.effective_pricing_scheme.present? %>
        <%= link_to "Tarifas: #{@court.effective_pricing_scheme.name}", admin_pricing_scheme_path(@court.effective_pricing_scheme), class: "badge badge-success", title: "Ver tarifas asociadas" %>
      <% end %>
    </div>
    <h1 class="page-title">Disponibilidad Semanal y Turnos: <%= @court.name %></h1>
    <p class="page-subtitle">
      Definí los días y horarios en los que la cancha estará abierta y disponible para reservas.
    </p>
  </div>
  <div class="header-actions">
    <%= link_to "Volver a Canchas", admin_courts_path, class: "btn btn-secondary" %>
  </div>
</div>

<!-- BANNER COMPACTO DE AYUDA CONTEXTUAL -->
<div class="banner-info">
  <span class="banner-info-icon">💡</span>
  <div class="banner-info-content">
    <strong>Configurá la disponibilidad de esta cancha:</strong>
    <span class="text-muted">
      Elegí los días, el horario de apertura y cierre y la duración de cada turno. Los horarios generados estarán disponibles para que los clientes puedan reservar.
    </span>
  </div>
</div>

<!-- GENERADOR RÁPIDO DE TURNOS Y DISPONIBILIDAD -->
<div class="content-card">
  <div class="section-header">
    <div>
      <h2 class="section-heading">Habilitar Turnos de Reserva</h2>
      <p class="card-section-desc mb-0">
        Generá la disponibilidad para los días seleccionados indicando la franja horaria y la duración de cada turno.
      </p>
    </div>
    <div class="section-counter">
      Total configurado: <strong class="font-bold"><%= @time_slots.count %></strong> turno(s) activos
    </div>
  </div>

  <%= form_with(url: admin_court_time_slots_path(@court), method: :post, local: true) do |f| %>
    <!-- Selección de Días -->
    <div class="form-group">
      <div class="day-selection-header">
        <label class="form-label mb-0">1. Elegí los días disponibles:</label>
        
        <!-- Atajos de selección con 1 clic -->
        <div class="btn-group-wrap mb-0">
          <button type="button" class="btn btn-sm btn-secondary" onclick="selectDays([1,2,3,4,5])">Lunes a Viernes</button>
          <button type="button" class="btn btn-sm btn-secondary" onclick="selectDays([6,0])">Fin de Semana</button>
          <button type="button" class="btn btn-sm btn-secondary" onclick="selectDays([1,2,3,4,5,6,0])">Toda la semana</button>
          <button type="button" class="btn btn-sm btn-secondary" onclick="selectDays([])">Desmarcar</button>
        </div>
      </div>

      <!-- Pastillas de días -->
      <div class="pill-group-container">
        <% [
          ['Lunes', 1], ['Martes', 2], ['Miércoles', 3], 
          ['Jueves', 4], ['Viernes', 5], ['Sábado', 6], ['Domingo', 0]
        ].each do |nombre, dia_val| %>
          <label class="day-pill" id="pill_<%= dia_val %>">
            <%= check_box_tag "days_of_week[]", dia_val, false, id: "day_#{dia_val}", class: "slot-day-checkbox", onchange: "updatePillStyle(this)" %>
            <span><%= nombre %></span>
          </label>
        <% end %>
      </div>
    </div>

    <!-- Rango de Horarios, Duración de Intervalo y Botón -->
    <div class="form-grid-slots">
      <div>
        <label class="form-label">2. Horario de apertura (desde):</label>
        <%= f.time_field :start_time, value: "14:00", required: true, class: "form-input font-bold" %>
      </div>

      <div>
        <label class="form-label">3. Horario de cierre (hasta):</label>
        <%= f.time_field :end_time, value: "23:00", required: true, class: "form-input font-bold" %>
      </div>

      <div>
        <label class="form-label">4. Duración de cada turno:</label>
        <%= f.select :slot_duration, [
          ['60 minutos (1 hora)', '60'],
          ['90 minutos (1h 30m)', '90'],
          ['30 minutos', '30'],
          ['120 minutos (2 horas)', '120'],
          ['Franja completa única (sin divisiones)', 'exact']
        ], { selected: '60' }, class: "form-input" %>
      </div>

      <div>
        <%= f.submit "Generar Turnos", class: "btn btn-primary btn-block" %>
      </div>
    </div>
  <% end %>
</div>

<!-- VISUALIZACIÓN DE LA GRILLA DE TURNOS SEMANALES -->
<div class="section-container">
  <div class="section-header">
    <div>
      <h2 class="section-heading">Cronograma Semanal de Disponibilidad</h2>
      <p class="card-section-desc mb-0">
        Revisá los turnos habilitados para cada día de la semana con su precio de reserva correspondiente.
      </p>
    </div>

    <!-- Controles de vista y vaciado -->
    <div class="view-controls">
      <!-- Toggle de vistas -->
      <div class="view-toggle-group">
        <button type="button" id="btn-view-cards" class="view-toggle-btn active" onclick="switchView('cards')">
          Vista Semanal
        </button>
        <button type="button" id="btn-view-table" class="view-toggle-btn" onclick="switchView('table')">
          Vista Tabla
        </button>
      </div>

      <% if @time_slots.any? %>
        <%= button_to "Vaciar todos los turnos", destroy_all_admin_court_time_slots_path(@court), method: :delete, data: { turbo_confirm: "¿Seguro que querés vaciar todos los turnos configurados de la cancha #{@court.name}? Esta acción no se puede deshacer." }, class: "btn btn-sm btn-outline-danger" %>
      <% end %>
    </div>
  </div>

  <!-- A. VISTA SEMANAL EN COLUMNAS / TARJETAS POR DÍA (DEFAULT) -->
  <div id="view-cards-container" class="slot-cards-grid">
    <% TimeSlot::DAY_ORDER.each do |dia_val| %>
      <% 
        dia_nombre = TimeSlot::DAYS[dia_val]
        day_slots = @slots_by_day[dia_val] || []
      %>
      <div class="slot-day-card">
        <!-- Cabecera del día -->
        <div class="slot-day-header <%= 'has-slots' if day_slots.any? %>">
          <div>
            <strong class="slot-day-title"><%= dia_nombre %></strong>
            <span class="badge badge-sm <%= day_slots.any? ? 'badge-primary' : 'badge-secondary' %>">
              <%= day_slots.size %> turno<%= 's' unless day_slots.size == 1 %>
            </span>
          </div>

          <% if day_slots.any? %>
            <%= button_to "Vaciar día", destroy_day_admin_court_time_slots_path(@court, day_of_week: dia_val), method: :delete, data: { turbo_confirm: "¿Eliminar todos los turnos del día #{dia_nombre}?" }, class: "btn btn-xs btn-outline-danger" %>
          <% end %>
        </div>

        <!-- Contenido / Lista de turnos del día -->
        <div class="slot-list">
          <% if day_slots.any? %>
            <% day_slots.each do |slot| %>
              <% 
                mult = slot.effective_multiplier
                price = slot.calculated_price
              %>
              <div class="slot-item">
                <div>
                  <div class="slot-time">
                    <%= slot.formatted_time_range %>
                  </div>
                  <div class="slot-meta">
                    <span class="text-muted"><%= slot.duration_in_hours %>h</span>
                    <span class="text-separator">&bull;</span>
                    <strong class="price-highlight">$<%= number_with_precision(price, precision: 2) %></strong>
                    <% if mult != 1.0 %>
                      <span class="badge badge-xs <%= mult > 1.0 ? 'badge-success' : 'badge-warning' %>" title="Tarifa ajustada para este horario">
                        x<%= mult %>
                      </span>
                    <% end %>
                  </div>
                </div>

                <div>
                  <%= button_to "×", admin_court_time_slot_path(@court, slot), method: :delete, data: { turbo_confirm: "¿Eliminar el turno #{slot.formatted_time_range} del #{dia_nombre}?" }, class: "btn-icon-delete", title: "Eliminar turno" %>
                </div>
              </div>
            <% end %>
          <% else %>
            <div class="slot-day-empty">
              Sin turnos habilitados<br>
              <span class="slot-closed-note">(Cerrado este día)</span>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <!-- B. VISTA TABLA COMPLETA (OPCIONAL) -->
  <div id="view-table-container" class="slot-table-wrapper is-hidden">
    <table class="admin-table mb-0">
      <thead>
        <tr>
          <th>Día</th>
          <th>Horario</th>
          <th>Duración</th>
          <th>Ajuste Tarifa</th>
          <th>Precio</th>
          <th class="text-right">Acción</th>
        </tr>
      </thead>
      <tbody>
        <% if @time_slots.any? %>
          <% @time_slots.each do |slot| %>
            <% 
              mult = slot.effective_multiplier
              price = slot.calculated_price
            %>
            <tr>
              <td><strong><%= slot.day_name %></strong></td>
              <td><strong class="font-bold"><%= slot.formatted_time_range %></strong></td>
              <td><%= slot.duration_in_hours %> h</td>
              <td>
                <% if mult != 1.0 %>
                  <span class="badge <%= mult > 1.0 ? 'badge-success' : 'badge-warning' %>">
                    x<%= mult %>
                  </span>
                <% else %>
                  <span class="badge badge-secondary">Estándar</span>
                <% end %>
              </td>
              <td>
                <strong class="price-highlight">$<%= number_with_precision(price, precision: 2) %></strong>
              </td>
              <td>
                <div class="table-actions text-right">
                  <%= button_to "Eliminar", admin_court_time_slot_path(@court, slot), method: :delete, data: { turbo_confirm: "¿Eliminar este turno?" }, class: "btn btn-sm btn-danger" %>
                </div>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="6" class="table-empty">No hay turnos configurados todavía.</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<script>
  function selectDays(daysArray) {
    var checkboxes = document.querySelectorAll('.slot-day-checkbox');
    checkboxes.forEach(function(cb) {
      cb.checked = daysArray.includes(parseInt(cb.value));
      updatePillStyle(cb);
    });
  }

  function updatePillStyle(cb) {
    var pill = document.getElementById('pill_' + cb.value);
    if (pill) {
      if (cb.checked) {
        pill.classList.add('day-pill-active');
      } else {
        pill.classList.remove('day-pill-active');
      }
    }
  }

  function switchView(mode) {
    var cardsView = document.getElementById('view-cards-container');
    var tableView = document.getElementById('view-table-container');
    var btnCards = document.getElementById('btn-view-cards');
    var btnTable = document.getElementById('btn-view-table');

    if (mode === 'table') {
      cardsView.classList.add('is-hidden');
      tableView.classList.remove('is-hidden');
      btnTable.classList.add('active');
      btnCards.classList.remove('active');
    } else {
      cardsView.classList.remove('is-hidden');
      tableView.classList.add('is-hidden');
      btnCards.classList.add('active');
      btnTable.classList.remove('active');
    }
  }

  // Inicializar estado visual de los checkboxes al cargar
  document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('.slot-day-checkbox').forEach(function(cb) {
      updatePillStyle(cb);
    });
  });
</script>
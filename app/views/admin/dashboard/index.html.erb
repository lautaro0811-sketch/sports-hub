<div class="page-header dashboard-header">
  <div>
    <div class="dashboard-title-row">
      <h1 class="page-title"><%= t("dashboard.title", default: "Dashboard Operativo") %></h1>
      <% if @selected_complex %>
        <span class="dashboard-venue-badge">
          <%= dashboard_icon(:building, classes: "badge-svg") %>
          <%= @selected_complex.name %>
        </span>
      <% else %>
        <span class="dashboard-venue-badge dashboard-venue-badge--all">
          <%= dashboard_icon(:building, classes: "badge-svg") %>
          <%= t("dashboard.filter.all_complexes", default: "Todos los complejos") %>
        </span>
      <% end %>
    </div>
    <p class="page-subtitle">
      <%= l(@selected_date || Date.current, format: :full).capitalize %>
    </p>
  </div>

  <%# ── Filtros y Calendario ── %>
  <%= form_with url: admin_root_path, method: :get, data: { turbo_frame: "dashboard_content" }, class: "dashboard-filter-form" do |f| %>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    
    <div class="dashboard-filter-layout">
      <div class="filter-fields-col">
        <div class="filter-field-row">
          <%= f.label :complex_id, "Complejo:" %>
          <%= f.select :complex_id,
              options_for_select(
                [[t("dashboard.filter.all_complexes", default: "Todos los complejos"), ""]] + @sports_complexes.map { |sc| [sc.name, sc.id] },
                @selected_complex_id
              ),
              {},
              "aria-label": "Seleccionar complejo deportivo",
              onchange: "this.form.requestSubmit()" %>
        </div>

        <div class="filter-field-row">
          <label>Estado:</label>
          <%= f.select :status_filter, 
              options_for_select(['Todos', 'Ocupados', 'Libres'], @status_filter), 
              {}, 
              onchange: "this.form.requestSubmit()" %>
        </div>
      </div>

      <div class="mini-calendar-container" data-controller="flatpickr-inline">
        <%= f.hidden_field :date, value: @selected_date.to_s, data: { flatpickr_inline_target: "input" } %>
      </div>
    </div>
    
    <noscript>
      <%= f.submit t("dashboard.filter.submit", default: "Filtrar"), class: "btn-primary dashboard-filter-submit" %>
    </noscript>
  <% end %>
</div>

<%= turbo_frame_tag "dashboard_content", data: { controller: "auto-refresh" } do %>
  <%= render "kpis" %>
  
  <% if @selected_date == Date.current %>
    <%= render "courts_status" %>
  <% end %>
  
  <%= render "daily_schedule" %>
<% end %>

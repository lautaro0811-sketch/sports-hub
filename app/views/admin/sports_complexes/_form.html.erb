<%= form_with model: [:admin, sports_complex], class: "admin-card" do |f| %>
  <% if sports_complex.errors.any? %>
    <div class="form-errors">
      <h3>Se encontraron <%= sports_complex.errors.count %> error(es) que impiden guardar el complejo:</h3>
      <ul>
        <% sports_complex.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= f.label :name, "Nombre del complejo", class: "form-label" %>
    <%= f.text_field :name, required: true, autofocus: true, class: "form-input", placeholder: "Ej. Complejo Central" %>
  </div>

  <div class="form-group">
    <%= f.label :address, "Dirección", class: "form-label" %>
    <%= f.text_field :address, required: true, class: "form-input", placeholder: "Ej. Calle 12 y 60" %>
  </div>

  <div class="form-group">
    <%= f.label :city, "Ciudad", class: "form-label" %>
    <%= f.text_field :city, required: true, class: "form-input", placeholder: "Ej. La Plata" %>
  </div>

  <div class="form-group">
    <%= f.label :phone, "Teléfono de contacto", class: "form-label" %>
    <%= f.telephone_field :phone, required: true, class: "form-input", placeholder: "Ej. 2214001122" %>
  </div>

  <div class="form-group">
    <%= f.label :default_pricing_scheme_id, "Esquema Tarifario Predeterminado", class: "form-label" %>
    <%= f.collection_select :default_pricing_scheme_id, PricingScheme.order(:name), :id, :name, { include_blank: "Ninguno (Tarifa base 1.0)" }, { class: "form-input" } %>
    <span class="table-subtext">
      Las canchas de este complejo heredarán este esquema automáticamente, a menos que configures un esquema específico para alguna de ellas.
    </span>
  </div>

  <div class="form-group">
    <%= f.label :cover_photo, "Foto de portada", class: "form-label" %>
    <% if sports_complex.cover_photo.attached? && sports_complex.cover_photo.persisted? %>
      <div class="form-image-preview">
        <%= image_tag sports_complex.cover_photo, alt: sports_complex.name %>
        <span class="table-empty">Foto actual</span>
      </div>
    <% end %>
    <%= f.file_field :cover_photo, accept: "image/png,image/jpeg,image/webp", class: "form-file" %>
  </div>

  <div class="form-actions">
    <%= f.submit sports_complex.new_record? ? "Crear Complejo" : "Actualizar Complejo", class: "btn btn-primary" %>
    <%= link_to "Cancelar", admin_sports_complexes_path, class: "btn btn-secondary" %>
  </div>
<% end %>
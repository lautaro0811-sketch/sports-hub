<%= form_with model: [:admin, pricing_scheme], class: "admin-card" do |f| %>
  <% if pricing_scheme.errors.any? %>
    <div class="form-errors">
      <h3>Se encontraron <%= pricing_scheme.errors.count %> error(es) al guardar el esquema:</h3>
      <ul>
        <% pricing_scheme.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= f.label :name, "Nombre del Esquema Tarifario", class: "form-label" %>
    <%= f.text_field :name, required: true, autofocus: true, class: "form-input", placeholder: "Ej. Tarifa estándar, Fin de semana, Temporada alta" %>
  </div>

  <div class="form-group">
    <%= f.label :description, "Descripción (opcional)", class: "form-label" %>
    <%= f.text_area :description, rows: 3, class: "form-input", placeholder: "Ej. Reglas aplicables a canchas de fútbol con recargo nocturno." %>
  </div>

  <div class="form-actions">
    <%= f.submit pricing_scheme.new_record? ? "Crear Esquema y Continuar" : "Actualizar Esquema", class: "btn btn-primary" %>
    <%= link_to "Cancelar", admin_pricing_schemes_path, class: "btn btn-secondary" %>
  </div>
<% end %>

